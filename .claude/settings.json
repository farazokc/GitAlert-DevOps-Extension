{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
"Bash(npm run *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(node --test)",
      "Bash(node --test *)"
    ],
    "deny": [
      "Bash(gh api --method DELETE *)",
      "Bash(gh api * --method DELETE)",
      "Bash(gh api * --method DELETE *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'TDD GATE: Write tests first. Watch them fail RED. Then implement GREEN. If no failing test exists yet, invoke the test-writer skill.'",
            "timeout": 5,
            "statusMessage": "TDD gate reminder..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint . && npx prettier --check .",
            "timeout": 60,
            "statusMessage": "Checking lint and formatting..."
          }
        ]
      }
    ]
  }
}
